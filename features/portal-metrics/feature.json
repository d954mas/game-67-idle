{
  "schema": "ai_studio.feature.v1",
  "id": "portal-metrics",
  "version": "0.1.0",
  "title": "Portal Metrics",
  "status": "opt-in",
  "kind": "gameplay-infrastructure",
  "summary": "In-place event-log drain for game-owned portal funnel mappers and direct platform SDK measures.",
  "copy_model": "in-place",
  "layer": "L1",
  "owners": [
    "features/portal-metrics"
  ],
  "dependencies": [
    "features/game-events for the frame event log",
    "features/platform-sdk for measure delivery"
  ],
  "commands": {
    "ctest": "ctest --test-dir games/<game-id>/build/<preset> -R test_portal_metrics --output-on-failure"
  },
  "provides": [
    "sys_portal_metrics_init game-owned event mapper registration",
    "sys_portal_metrics_record once-per-frame event-log drain",
    "sys_portal_metrics_measure direct portal funnel delivery"
  ],
  "flags": {
    "feature": "FEATURE_PORTAL_METRICS=1 in consuming game/template targets"
  },
  "manuals": {
    "install": "features/portal-metrics/INSTALL.md"
  },
  "registers": {
    "target_sources": [
      "${PORTAL_METRICS_SRC}/sys_portal_metrics.c"
    ],
    "include_dirs": [
      "${PORTAL_METRICS_INC}"
    ],
    "runtime_hooks": [
      "init before frame work",
      "record after every other game-event reader"
    ],
    "ctest_targets": [
      "test_portal_metrics"
    ]
  }
}
