include_guard(GLOBAL)

function(game_recording_attach host)
    target_include_directories(${host} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/include")
    if(NOT NT_DEVAPI_GROUP_RECORDER)
        return()
    endif()
    if(NOT WIN32 OR EMSCRIPTEN OR NOT GAME_DEVAPI_ENABLED)
        message(FATAL_ERROR "game-recording requires a Windows native DevAPI build")
    endif()
    set(audio "${host}")
    if(ARGC GREATER 1)
        set(audio "${ARGV1}")
    endif()
    target_sources(${host} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/recording.c")
    target_compile_definitions(${audio} PRIVATE AUDIO_CORE_CAPTURE_ENABLED=1)
    target_compile_definitions(${host} PRIVATE AUDIO_CORE_CAPTURE_ENABLED=1)
    target_include_directories(${host} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../audio-core/include")
    target_link_libraries(${host} PRIVATE nt_recorder nt_devapi cjson nt_time)
endfunction()
