{
  "schema": "ai_studio.feature.v1",
  "id": "items-core",
  "version": "6.0.0",
  "title": "Items Core",
  "status": "reusable",
  "kind": "gameplay-infrastructure",
  "summary": "In-place L1 module: deterministic Lua item declarations, a generated typed C catalog, ownership operations, and focused tooling.",
  "copy_model": "in-place",
  "layer": "L1",
  "owners": [
    "features/items-core"
  ],
  "dependencies": [
    "Python 3.12",
    "Lupa 2.8 using its bundled lupa.lua54 backend (installed by the AI Studio Python environment)",
    "game-events",
    "game-state",
    "a game-local items.lua.json manifest plus allowlisted Lua modules",
    "template or game C runtime compiling the generated items catalog + generated items save fragment (features/game-state)",
    "the consuming game's own src/features/items/reason_tags.h (closed reason-verb list, resolved via the game's include path)"
  ],
  "commands": {
    "list": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> list",
    "detail": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> detail --item <item-id>",
    "validate": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> validate",
    "schema": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> schema",
    "build": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> build --out-dir <build-dir>",
    "seal_receipt": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> seal-receipt",
    "c_catalog": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_c_catalog.py --snapshot <snapshot.json> --out-dir <build-dir>",
    "c_catalog_test": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_c_catalog_test.py",
    "lua_evaluate": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_lua_sandbox.py evaluate --root <game-root> --manifest <game-root>/items.lua.json",
    "lua_sandbox_test": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_lua_sandbox_test.py",
    "snapshot_build": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot.py build --evaluation <evaluation.json> --out <snapshot.json>",
    "snapshot_query": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot.py query --snapshot <snapshot.json> --item <item-id>",
    "snapshot_chart": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot.py chart --snapshot <snapshot.json> --item <item-id> --field <field>",
    "snapshot_requirements": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot.py requirements --snapshot <snapshot.json>",
    "snapshot_diff": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot.py diff --before <old-snapshot.json> --after <new-snapshot.json>",
    "snapshot_test": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_snapshot_test.py",
    "semantic_cli": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli.py --project-root <game-root> <operation>",
    "semantic_cli_test": "node ai_studio/dev_environment/python_run.mjs features/items-core/scripts/items_cli_test.py",
    "semantic_cli_benchmark": "node ai_studio/dev_environment/python_run.mjs features/items-core/benchmarks/benchmark_items_cli.py --project-root <game-root> --out <result.json>",
    "pipeline_benchmark": "node ai_studio/dev_environment/python_run.mjs features/items-core/benchmarks/benchmark_items_pipeline.py --build-dir <release-build-dir> --out <result.json>"
  },
  "manuals": {
    "install": "features/items-core/INSTALL.md",
    "typed_catalog_contract": "features/items-core/docs/items_typed_catalog_contract.md",
    "lua_authoring_contract": "features/items-core/docs/items_lua_single_source_concept_2026-07-10.md"
  },
  "outputs": [
    "items.lua.evaluation.v1 JSON",
    "items.snapshot.v1 JSON",
    "items.snapshot.chart.v1 JSON",
    "items.snapshot.requirements.v1 JSON",
    "items.snapshot.diff.v1 JSON"
  ],
  "catalog_outputs": [
    "items_catalog.gen.h",
    "items_catalog.internal.gen.h",
    "items_catalog.gen.c",
    "items_catalog.luau"
  ],
  "registers": {
    "note": "Describes the EXISTING wiring in templates/template/CMakeLists.txt (target_sources/ctest) -- items-core is an in-place module (precedent features/game-state), not an install-script target. This section documents the consuming game's provisioning, it does not perform it.",
    "target_sources": [
      "${ITEMS_CORE_SRC}/items_api.c",
      "${ITEMS_CATALOG_SOURCE}",
      "${ITEMS_CORE_SRC}/items_containers.c",
      "${ITEMS_CORE_SRC}/items_reconcile.c"
    ],
    "include_dirs": [
      "${ITEMS_CORE_INC}",
      "${GAME_EVENTS_INC}",
      "${GAME_STATE_INC}"
    ],
    "ctest_targets": [
      "test_items_fragment",
      "items_catalog_validate",
      "test_items_api_core_only",
      "test_items_api",
      "items_c_catalog_test"
    ]
  },
  "default_template": {
    "manifest": "templates/template/items.lua.json",
    "lua_modules": "templates/template/design/items/*.lua",
    "lock": "templates/template/content/items.lock.json",
    "state_schema": "templates/template/state/items.schema.json",
    "generated_dir": "templates/template/<build>/generated/items-catalog",
    "game_side_sources": [
      "templates/template/src/features/items/reason_tags.h",
      "templates/template/src/game_items.c",
      "templates/template/src/game_items.h",
      "templates/template/src/game_items_devapi.c"
    ]
  }
}
