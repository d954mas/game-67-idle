{
  "schema": "ai_studio.publish_target.v1",
  "target": "poki",
  "platform_sdk": "poki",
  "required_files": [
    "index.html",
    "game.js",
    "game.wasm",
    "assets/game.ntpack",
    "runtime-build.json",
    "platform-sdk.js",
    "platform-sdk-adapter.js"
  ],
  "packaged_required_files": [
    "index.html",
    "game.js",
    "game.wasm",
    "assets/game.ntpack",
    "runtime-build.json"
  ],
  "optional_files": [
    "assets/font_cjk.ntpack",
    "assets/music.ntpack",
    "assets/cosmetics.ntpack",
    "assets/theme_candy.ntpack",
    "assets/theme_dino.ntpack",
    "assets/theme_toy.ntpack",
    "assets/theme_robot.ntpack",
    "assets/theme_alien.ntpack",
    "assets/ui/loading_slime.png",
    "loading-title.webp",
    "loading-tram.webp"
  ],
  "zip_layout": "Flat upload root accepted by Poki Inspector: index.html, bundled game.js, game.wasm, runtime-build.json, and assets/game.ntpack.",
  "metadata": {
    "portal": "Poki Inspector",
    "requires_account": true,
    "submission_tool": "https://inspector.poki.dev",
    "orientation": "game-owned",
    "viewport": "responsive canvas"
  },
  "sdk_policy": {
    "adapter": "poki",
    "sdk_url": "https://game-cdn.poki.com/scripts/v2/poki-sdk.js",
    "load_policy": "The selected adapter is embedded into game.js and loads the SDK during web backend init; no HTML injection.",
    "ads": "commercialBreak for interstitial, rewardedBreak for rewarded opt-in",
    "debug_ui": "forbidden in release artifact",
    "forbidden_markers": [
      "YaGames.init",
      "https://bridge.playgama.com/v1/stable/playgama-bridge.js",
      "Show interstitial ad",
      "Show rewarded ad",
      "debug_test"
    ]
  },
  "validation_command": "node features/platform-sdk/scripts/artifact_tools.mjs inspect --target poki --artifact <artifact-dir>"
}
