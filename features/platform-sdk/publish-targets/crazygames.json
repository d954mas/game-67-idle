{
  "schema": "ai_studio.publish_target.v1",
  "target": "crazygames",
  "platform_sdk": "crazygames",
  "required_files": [
    "index.html",
    "game.js",
    "game.wasm",
    "assets/game.ntpack",
    "runtime-build.json",
    "platform-sdk.js",
    "platform-sdk-adapter.js"
  ],
  "packaged_required_files": [
    "index.html",
    "game.js",
    "game.wasm",
    "assets/game.ntpack",
    "runtime-build.json"
  ],
  "optional_files": [
    "assets/font_cjk.ntpack",
    "assets/music.ntpack",
    "assets/cosmetics.ntpack",
    "assets/theme_candy.ntpack",
    "assets/theme_dino.ntpack",
    "assets/theme_toy.ntpack",
    "assets/theme_robot.ntpack",
    "assets/theme_alien.ntpack",
    "assets/ui/loading_slime.png",
    "loading-title.webp",
    "loading-tram.webp"
  ],
  "zip_layout": "CrazyGames upload root: index.html, bundled game.js, game.wasm, runtime-build.json, and assets/game.ntpack. The portal SDK is loaded from its CDN and is never bundled.",
  "metadata": {
    "portal": "CrazyGames",
    "requires_account": true,
    "sdk_loader": "https://sdk.crazygames.com/crazygames-sdk-v3.js",
    "orientation": "game-owned",
    "viewport": "responsive canvas",
    "initial_download_budget_bytes": 52428800,
    "initial_download_budget_bytes_mobile": 20971520
  },
  "sdk_policy": {
    "adapter": "crazygames",
    "sdk_url": "https://sdk.crazygames.com/crazygames-sdk-v3.js",
    "load_policy": "The selected adapter is embedded into game.js and loads the portal CDN script during web backend init. The portal forbids bundling or self-hosting its SDK, so the URL must survive minification unchanged.",
    "ads": "ad.requestAd('midgame') for interstitial, ad.requestAd('rewarded') for rewarded; reward only on adFinished",
    "storage": "data.getItem/setItem through the wrapper only, 1 MB per game",
    "debug_ui": "forbidden in release artifact",
    "forbidden_markers": [
      "https://game-cdn.poki.com/scripts/v2/poki-sdk.js",
      "https://bridge.playgama.com/v1/stable/playgama-bridge.js",
      "https://bridge.playgama.com/v2/stable/playgama-bridge.js",
      "YaGames.init",
      "Show interstitial ad",
      "Show rewarded ad",
      "debug_test"
    ],
    "required_markers": [
      "https://sdk.crazygames.com/crazygames-sdk-v3.js"
    ]
  },
  "validation_command": "node features/platform-sdk/scripts/artifact_tools.mjs inspect --target crazygames --artifact <artifact-dir>"
}
