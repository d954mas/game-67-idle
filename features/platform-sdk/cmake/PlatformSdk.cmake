# Closure renames every property of the client's EM_JS code unless an externs
# file names it; the platform bundle is outside Closure, so the names they
# share must be listed. Call for a target that links with --closure 1.
#
#   include("${PLATFORM_SDK_DIR}/cmake/PlatformSdk.cmake")
#   platform_sdk_closure_externs(my_client)

function(platform_sdk_closure_externs target)
    set(_externs "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../web/platform_sdk.externs.js")
    cmake_path(NORMAL_PATH _externs)
    target_link_options(${target} PRIVATE "SHELL:--closure-args=--externs=${_externs}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${_externs}")
endfunction()

function(platform_sdk_crash target)
    if(NOT EMSCRIPTEN)
        return()
    endif()
    if(NOT DEFINED GAME_CRASH_STORAGE_PREFIX)
        set(_identity "${CMAKE_CURRENT_SOURCE_DIR}/game.json")
        if(NOT EXISTS "${_identity}")
            set(_identity "${CMAKE_CURRENT_SOURCE_DIR}/template.json")
        endif()
        file(READ "${_identity}" _identity_json)
        string(JSON _namespace GET "${_identity_json}" storageNamespace)
        set(GAME_CRASH_STORAGE_PREFIX "${_namespace}.crash")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_identity}")
    endif()
    if(NOT GAME_CRASH_STORAGE_PREFIX MATCHES "^[a-zA-Z0-9_.-]+$" OR
       GAME_CRASH_STORAGE_PREFIX MATCHES "^\\.")
        message(FATAL_ERROR "Crash storage prefix must be a non-empty literal namespace")
    endif()
    string(LENGTH "${GAME_CRASH_STORAGE_PREFIX}.v1" _key_length)
    if(_key_length GREATER_EQUAL 256)
        message(FATAL_ERROR "Crash storage key exceeds the engine limit")
    endif()
    set(_source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../web/runtime-diagnostics.js")
    file(READ "${_source}" PLATFORM_SDK_DIAGNOSTICS_JS)
    string(REGEX REPLACE "[\r\n]+$" "" PLATFORM_SDK_DIAGNOSTICS_JS "${PLATFORM_SDK_DIAGNOSTICS_JS}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
    target_link_libraries(${target} PRIVATE nt_crash)
    target_compile_definitions(${target} PRIVATE
        GAME_CRASH_STORAGE_KEY="${GAME_CRASH_STORAGE_PREFIX}.v1")
    set(GAME_CRASH_STORAGE_PREFIX "${GAME_CRASH_STORAGE_PREFIX}" PARENT_SCOPE)
    set(PLATFORM_SDK_DIAGNOSTICS_JS "${PLATFORM_SDK_DIAGNOSTICS_JS}" PARENT_SCOPE)
endfunction()
