{
  "schema": "ai_studio.feature.v1",
  "id": "game-state",
  "version": "4.4.0",
  "title": "Game State",
  "status": "reusable",
  "kind": "gameplay-infrastructure",
  "summary": "Schema-first generated game state with readable text saves and JSON DevAPI adapters.",
  "copy_model": "in-place",
  "layer": "L0",
  "owners": [
    "features/game-state"
  ],
  "dependencies": [
    "Python 3.12",
    "templates/template/state/game_state.schema.json or a game-local state schema",
    "template or game C runtime using generated GameState files",
    "features/game-events >= 2.1.0 for schemas declaring repeated sections: the emitters this generates use its six-member descriptor and record type",
    "Neotolis engine targets nt_time and nt_log; DevAPI targets when enabled"
  ],
  "provides": [
    "GameSaveFragment registry and save lifecycle",
    "game_storage slot persistence API",
    "bounded caller-owned allocation-free snapshot writer",
    "allocation-free readable text codec for scalar fragments",
    "game_state_json validation helpers",
    "schema-first C state generation",
    "optional game.state.* DevAPI dispatch"
  ],
  "flags": {
    "devapi": "GAME_DEVAPI_ENABLED",
    "devapi_condition": "GAME_DEVAPI_ENABLED"
  },
  "commands": {
    "generate": "node ai_studio/dev_environment/python_run.mjs features/game-state/scripts/generate_state.py --schema templates/template/state/game_state.schema.json",
    "test": "node ai_studio/dev_environment/python_run.mjs features/game-state/scripts/run_tests.py"
  },
  "manuals": {
    "install": "features/game-state/INSTALL.md",
    "contract": "features/game-state/references/contract.md",
    "workflow": "features/game-state/references/workflow.md",
    "review": "features/game-state/references/review.md"
  },
  "outputs": [
    "<id>_state.h",
    "<id>_state.c",
    "<id>_state_schema.gen.h",
    "<id>_state_events.gen.h",
    "<id>_state_events.gen.c"
  ],
  "default_template": {
    "schema": "templates/template/state/game_state.schema.json",
    "generated_dir": "templates/template/build/<config>/generated/game-state",
    "runtime_sources": [
      "features/game-state/src/game_state_json.c",
      "features/game-state/src/game_save_writer.c",
      "features/game-state/src/game_save_text.c",
      "features/game-state/src/game_storage.c",
      "features/game-state/src/game_save.c",
      "features/game-state/src/game_save_devapi.c"
    ],
    "platform_sources": {
      "native": [
        "features/game-state/src/game_save_platform_native.c",
        "features/game-state/src/game_storage_backend_native.c"
      ],
      "web": [
        "features/game-state/src/game_save_platform_web.c",
        "features/game-state/src/game_storage_backend_web.c",
        "features/game-state/src/game_storage_web.c"
      ]
    },
    "runtime_include": "features/game-state/include"
  }
}
