    "e2e.every_category": {
      "note": "Arabic is the only rule using every CLDR category, so this is the only key that reads the zero and two slots -- which nothing else in this fixture, and nothing in any game corpus so far, has ever done. The forms are markers, not prose: the assertion is about WHICH SLOT was read, and real text would make it about the translation instead.",
      "args": {
        "n": "int"
      },
      "plural_on": "n",
      "ru": {
        "one": "ru-one {n}",
        "few": "ru-few {n}",
        "many": "ru-many {n}"
      },
      "en": {
