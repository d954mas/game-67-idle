{
  "languages": {
    "ru": {
      "group_separator": " ",
      "group_min_digits": 5
    },
    "en": {
      "group_separator": ",",
      "group_min_digits": 4
    },
    "ja": {
      "group_separator": ",",
      "group_min_digits": 4
    },
    "pl": {
      "group_separator": " ",
      "group_min_digits": 5
    },
    "cs": {
      "group_separator": " ",
      "group_min_digits": 5
    },
    "fr": {
      "group_separator": " ",
      "group_min_digits": 5
    },
    "ar": {
      "group_separator": ",",
      "group_min_digits": 4
    }
  },
  "fallback": "ru",
  "strings": {
    "e2e.plain": {
      "note": "Zero-argument key: loc_get returns the table pointer with no expansion.",
      "ru": "ЗАКРЫТЬ",
      "en": "CLOSE",
      "ja": "閉じる",
      "pl": "ZAMKNIJ",
      "cs": "ZAVRIT",
      "fr": "FERMER",
      "ar": "CLOSE"
    },
    "e2e.braces_bare": {
      "note": "Escapes must already be resolved at build time -- nothing unescapes a zero-arg key.",
      "ru": "100% {{готово}}",
      "en": "100% {{done}}",
      "ja": "100% {{完了}}",
      "pl": "100% {{gotowe}}",
      "cs": "100% {{hotovo}}",
      "fr": "100% {{fini}}",
      "ar": "100% {{done}}"
    },
    "e2e.braces_arg": {
      "note": "Escapes in a template are resolved by the runtime while it expands.",
      "args": {
        "what": "str"
      },
      "ru": "100% {{{what}}}",
      "en": "100% {{{what}}}",
      "ja": "100% {{{what}}}",
      "pl": "100% {{{what}}}",
      "cs": "100% {{{what}}}",
      "fr": "100% {{{what}}}",
      "ar": "100% {{{what}}}"
    },
    "e2e.reordered": {
      "note": "Argument order differs per language; slots are indices, not positions.",
      "args": {
        "first": "str",
        "second": "str"
      },
      "ru": "{second} затем {first}",
      "en": "{first} then {second}",
      "ja": "{first} と {second}",
      "pl": "{second} potem {first}",
      "cs": "{second} pak {first}",
      "fr": "{second} puis {first}",
      "ar": "{first} then {second}"
    },
    "e2e.numbers": {
      "note": "Every arg type in one key, including grouping from the language block.",
      "args": {
        "n": "int",
        "grouped": "int:group",
        "one_dp": "float:1",
        "two_dp": "float:2",
        "shortest": "float:g"
      },
      "ru": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "en": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "ja": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "pl": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "cs": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "fr": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}",
      "ar": "{n}|{grouped}|{one_dp}|{two_dp}|{shortest}"
    },
    "e2e.widest": {
      "note": "LOC_MAX_ARGS arguments in one key -- the _Static_assert's upper edge.",
      "args": {
        "a": "int",
        "b": "int",
        "c": "int",
        "d": "int",
        "e": "int",
        "f": "int",
        "g": "int",
        "h": "int"
      },
      "ru": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "en": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "ja": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "pl": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "cs": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "fr": "{a}{b}{c}{d}{e}{f}{g}{h}",
      "ar": "{a}{b}{c}{d}{e}{f}{g}{h}"
    },
    "e2e.hole": {
      "note": "Only the fallback language carries this one.",
      "ru": "ТОЛЬКО РУ"
    },
    "e2e.counted": {
      "note": "One plural key per rule family -- this is what pins PLURAL_RULE_CATS against plural_select().",
      "args": {
        "n": "int"
      },
      "plural_on": "n",
      "ru": {
        "one": "{n} шаг",
        "few": "{n} шага",
        "many": "{n} шагов"
      },
      "en": {
        "one": "{n} step",
        "other": "{n} steps"
      },
      "ja": {
        "other": "{n} 歩"
      },
      "pl": {
        "one": "{n} krok",
        "few": "{n} kroki",
        "many": "{n} krokow"
      },
      "cs": {
        "one": "{n} krok",
        "few": "{n} kroky",
        "other": "{n} kroku"
      },
      "fr": {
        "one": "{n} pas",
        "other": "{n} pas x"
      },
      "ar": {
        "zero": "ar-zero {n}",
