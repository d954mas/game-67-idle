        "two": "ar-two {n}",
        "few": "ar-few {n}",
        "many": "ar-many {n}",
        "other": "ar-other {n}"
      }
    },
    "e2e.fractional": {
      "note": "A float plural_on always selects `other`, so `other` is all it may declare.",
      "args": {
        "n": "float:1"
      },
      "plural_on": "n",
      "ru": {
        "other": "{n} метра"
      },
      "en": {
        "other": "{n} metres"
      },
      "ja": {
        "other": "{n} メートル"
      },
      "pl": {
        "other": "{n} metra"
      },
      "cs": {
        "other": "{n} metru"
      },
      "fr": {
        "other": "{n} metres"
      },
      "ar": {
        "other": "{n} metres"
      }
    },
    "e2e.nested_outer": {
      "note": "Nesting: the inner key arrives as a `str` argument, never by concatenation.",
      "args": {
        "inner": "str",
        "n": "int"
      },
      "ru": "Нужно {inner} Ур {n}",
      "en": "Requires {inner} Lv {n}",
      "ja": "{inner} レベル {n} が必要",
      "pl": "Wymaga {inner} Poz {n}",
      "cs": "Vyzaduje {inner} Ur {n}",
      "fr": "Requiert {inner} Niv {n}",
      "ar": "Requires {inner} Lv {n}"
