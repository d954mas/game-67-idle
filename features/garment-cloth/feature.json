  "version": "2.0.0",
  "title": "Garment cloth",
  "status": "opt-in",
  "kind": "gameplay-foundation",
  "summary": "Caller-owned triangle cloth on the professional scheme: a skinned reference per vertex, max-distance and backstop spheres from it, the NvCloth substep order with anisotropic XPBD fabric, Grinspun Discrete Shells bending and tension-field compression, round-cone body shapes and game convexes with Coulomb friction inside the contact projection, joint interpolation by local slerp and forward kinematics, explicit reset, non-degenerate quaternion surface transfer, and one cooked blob per outfit viewed in place.",
  "copy_model": "in-place",
  "layer": "L0",
  "owners": ["features/garment-cloth"],
  "dependencies": ["engine nt_core and nt_math", "engine nt_skeletal and nt_hash for skeletal actors", "Python with NumPy for authoring", "SciPy for surface projection", "Pillow for the cards of garment.view", "ai_studio/assets/tools/blender/lib/glb.py for the poses garment.host reads"],
