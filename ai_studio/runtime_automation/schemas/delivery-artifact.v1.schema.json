{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.delivery_artifact.v1",
  "title": "Delivery Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "encode_job_id", "master_take_id", "master_take_hash",
    "preset_id", "artifact", "media_probe", "constraint_results", "provenance"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.delivery_artifact.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "encode_job_id": {"type": "string", "minLength": 1},
    "master_take_id": {"type": "string", "minLength": 1},
    "master_take_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preset_id": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "media_probe": {"$ref": "#/$defs/media_probe"},
    "constraint_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema", "constraint_id", "platform", "surface", "constraint_hash",
          "coverage", "status", "failures"
        ],
        "properties": {
          "schema": {"const": "ai_studio.capture.delivery_constraint_result.v1"},
          "constraint_id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "constraint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "coverage": {"enum": ["official", "official_partial"]},
          "status": {"enum": ["pass", "fail"]},
          "failures": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "pass"}}},
            "then": {"properties": {"failures": {"maxItems": 0}}}
          },
          {
            "if": {"properties": {"status": {"const": "fail"}}},
            "then": {"properties": {"failures": {"minItems": 1}}}
          }
        ]
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "media_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "probe_sha256", "container", "width", "height", "fps",
        "video_codec", "duration_seconds", "audio_policy_id", "audio_streams"
      ],
      "properties": {
        "schema": {"const": "ai_studio.capture.media_probe.v1"},
        "probe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "container": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1, "maximum": 7680},
        "height": {"type": "integer", "minimum": 1, "maximum": 7680},
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        "video_codec": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "audio_policy_id": {
          "enum": ["none", "game", "system", "microphone", "game+mic", "system+mic"]
        },
        "audio_streams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "track_index", "source_id", "role", "codec", "sample_rate",
              "channels", "channel_layout"
            ],
            "properties": {
              "track_index": {"type": "integer", "minimum": 0},
              "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "role": {
                "enum": ["game", "system", "microphone", "compatibility_mix"]
              },
              "codec": {"type": "string", "minLength": 1},
              "sample_rate": {"type": "integer", "minimum": 8000},
              "channels": {"type": "integer", "minimum": 1},
              "channel_layout": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"audio_policy_id": {"const": "none"}}},
          "then": {"properties": {"audio_streams": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {
              "audio_policy_id": {"const": "game"}
            }
          },
          "then": {
            "properties": {
              "audio_streams": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "track_index": {"const": 0},
                    "role": {"const": "game"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"audio_policy_id": {"const": "system"}}},
          "then": {
            "properties": {
              "audio_streams": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "track_index": {"const": 0},
                    "role": {"const": "system"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"audio_policy_id": {"const": "microphone"}}},
          "then": {
            "properties": {
              "audio_streams": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "track_index": {"const": 0},
                    "role": {"const": "microphone"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audio_policy_id": {"enum": ["game+mic", "system+mic"]}
            }
          },
          "then": {
            "properties": {
              "audio_streams": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "track_index": {"const": 0},
                    "role": {"const": "compatibility_mix"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "created_at", "job_hash", "capability_hash",
        "environment_hash", "media_probe_hash", "terminal_status", "artifacts"
      ],
      "properties": {
        "schema": {"const": "ai_studio.capture.provenance.v1"},
        "created_at": {"type": "string", "format": "date-time"},
        "job_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_probe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "terminal_status": {"const": "promoted"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact_inventory_entry"}
        }
      }
    },
    "artifact_inventory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
