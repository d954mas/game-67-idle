{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.delivery_media_descriptor.v1",
  "title": "Delivery Media Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "container", "width", "height", "fps", "video_codec",
    "audio_codec", "sample_rate", "duration_seconds", "bytes"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.delivery_media_descriptor.v1"},
    "container": {"type": "string", "minLength": 1, "maxLength": 32},
    "width": {"type": "integer", "minimum": 1, "maximum": 7680},
    "height": {"type": "integer", "minimum": 1, "maximum": 7680},
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "video_codec": {"type": "string", "minLength": 1, "maxLength": 64},
    "audio_codec": {"type": "string", "minLength": 1, "maxLength": 64},
    "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "bytes": {"type": "integer", "minimum": 1}
  }
}
