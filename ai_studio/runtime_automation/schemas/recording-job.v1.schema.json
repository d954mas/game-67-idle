{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.recording_job.v1",
  "title": "Recording Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "game_id", "mode", "target_id", "target_hash",
    "audio_policy_id", "audio_policy_hash", "backend", "video_source"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.recording_job.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "game_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["live", "authored"]},
    "target_id": {"type": "string", "minLength": 1},
    "target_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audio_policy_id": {"type": "string", "minLength": 1},
    "audio_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"enum": ["auto", "obs", "ffmpeg"]},
    "video_source": {"type": "string", "minLength": 1, "maxLength": 512},
    "shot_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "framing_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
