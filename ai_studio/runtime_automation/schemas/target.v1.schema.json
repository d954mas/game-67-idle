{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.target.v1",
  "title": "Capture Target v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "version", "width", "height", "fps", "framing",
    "capture_profile", "safe_area_policy", "delivery_preset"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.target.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"const": 1},
    "width": {"type": "integer", "minimum": 64, "maximum": 7680},
    "height": {"type": "integer", "minimum": 64, "maximum": 7680},
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1, "maximum": 240000},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 1001}
      }
    },
    "framing": {"enum": ["landscape", "portrait", "square", "custom"]},
    "capture_profile": {"type": "string", "minLength": 1},
    "safe_area_policy": {"type": ["string", "null"]},
    "delivery_preset": {"type": ["string", "null"]}
  }
}
