{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.encode_job.v1",
  "title": "Encode Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "master_take_id", "master_sha256", "preset_id",
    "preset_hash", "state", "staging_path"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.encode_job.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "master_take_id": {"type": "string", "minLength": 1},
    "master_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preset_id": {"type": "string", "minLength": 1},
    "preset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "enum": ["created", "encoding", "validating", "promoted", "failed", "abandoned"]
    },
    "staging_path": {"type": "string", "minLength": 1, "maxLength": 1024}
  }
}
