{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.audio_policy.v1",
  "title": "Capture Audio Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "expectation", "source_ids"],
  "properties": {
    "schema": {"const": "ai_studio.capture.audio_policy.v1"},
    "id": {
      "enum": ["none", "game", "system", "microphone", "game+mic", "system+mic"]
    },
    "expectation": {"enum": ["any", "activity_required"]},
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"id": {"const": "none"}}},
      "then": {
        "properties": {
          "expectation": {"const": "any"},
          "source_ids": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"id": {"enum": ["game+mic", "system+mic"]}}},
      "then": {"properties": {"source_ids": {"minItems": 2}}}
    },
    {
      "if": {
        "properties": {
          "id": {"enum": ["game", "system", "microphone"]}
        }
      },
      "then": {"properties": {"source_ids": {"minItems": 1}}}
    }
  ]
}
