{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.attempt.v1",
  "title": "Capture Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "job_id", "number", "state", "staging_path",
    "stop_reason", "failure_code"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.attempt.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "number": {"type": "integer", "minimum": 1},
    "state": {
      "enum": [
        "created", "preflighted", "countdown", "recording", "stopping",
        "validating", "promoted", "failed", "abandoned"
      ]
    },
    "staging_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [
        null, "requested", "hotkey", "ctrl_c", "timeout", "game_exit",
        "backend_exit", "low_disk", "cancelled"
      ]
    },
    "failure_code": {
      "type": ["string", "null"],
      "enum": [
        null, "CAPABILITY_MISSING", "SOURCE_NOT_FOUND",
        "AUDIO_SOURCE_NOT_FOUND", "AUDIO_TRACK_MISSING",
        "AUDIO_ACTIVITY_MISSING", "AUDIO_ROUTING_INVALID",
        "TARGET_UNSUPPORTED", "SOURCE_SIZE_MISMATCH",
        "BACKEND_START_FAILED", "BACKEND_EXITED", "GAME_EXITED",
        "STOP_TIMEOUT", "AV_VALIDATION_FAILED", "LOW_DISK",
        "CONTRACT_MISMATCH", "RELEASE_SURFACE_LEAK"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["created", "preflighted", "countdown", "recording"]
          }
        }
      },
      "then": {
        "properties": {
          "stop_reason": {"const": null},
          "failure_code": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"enum": ["stopping", "validating", "promoted"]}}
      },
      "then": {
        "properties": {
          "stop_reason": {"type": "string"},
          "failure_code": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}},
      "then": {"properties": {"failure_code": {"type": "string"}}}
    },
    {
      "if": {"properties": {"state": {"const": "abandoned"}}},
      "then": {
        "properties": {
          "stop_reason": {"type": "string"},
          "failure_code": {"const": null}
        }
      }
    }
  ]
}
