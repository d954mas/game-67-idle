{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.delivery_preset.v1",
  "title": "Delivery Preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "version", "container", "video", "audio",
    "metadata_policy", "source"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.delivery_preset.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"const": 1},
    "container": {"enum": ["mp4", "mkv", "mov"]},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "pixel_format", "fps_policy", "color_policy"],
      "properties": {
        "codec": {"type": "string", "minLength": 1},
        "pixel_format": {"type": "string", "minLength": 1},
        "fps_policy": {"enum": ["copy", "exact"]},
        "color_policy": {"type": "string", "minLength": 1}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "sample_rate", "channels"],
      "properties": {
        "codec": {"type": "string", "minLength": 1},
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "channels": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "metadata_policy": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "reviewed_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    }
  }
}
