{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.critical_region_result.v1",
  "title": "Critical Region Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "required_ticks", "measured_ticks", "missing_ticks",
    "violations"
  ],
  "properties": {
    "schema": {"const": "ai_studio.capture.critical_region_result.v1"},
    "status": {"enum": ["pass", "fail", "not_measured"]},
    "required_ticks": {"$ref": "#/$defs/ticks"},
    "measured_ticks": {"$ref": "#/$defs/ticks"},
    "missing_ticks": {"$ref": "#/$defs/ticks"},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_tick", "end_tick_exclusive"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start_tick": {"type": "integer", "minimum": 0},
          "end_tick_exclusive": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "ticks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
