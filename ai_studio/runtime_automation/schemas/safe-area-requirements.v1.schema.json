{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_studio.capture.safe_area_requirements.v1",
  "title": "Safe Area Requirements v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "target_id", "required_variants"],
  "properties": {
    "schema": {"const": "ai_studio.capture.safe_area_requirements.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"const": 1},
    "target_id": {"type": "string", "minLength": 1},
    "required_variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform", "surface", "ui_variant_id",
          "caption_variant_id", "direction"
        ],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "ui_variant_id": {"type": "string", "minLength": 1},
          "caption_variant_id": {"type": "string", "minLength": 1},
          "direction": {"enum": ["LTR", "RTL"]}
        }
      }
    }
  }
}
