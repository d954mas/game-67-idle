{
  "schema": "game_seed.settings",
  "schema_version": 2,
  "fragment": "settings",
  "version": 1,
  "string_max": 32,
  "enums": {
    "Language": ["en", "ru"],
    "GraphicsQuality": ["high", "low"]
  },
  "fields": {
    "master_volume": { "type": "float", "default": 0.8, "min": 0, "max": 1 },
    "music_volume":  { "type": "float", "default": 0.7, "min": 0, "max": 1 },
    "sfx_volume":    { "type": "float", "default": 0.9, "min": 0, "max": 1 },
    "language":      { "type": "enum", "enum": "Language", "default": "en" },
    "language_chosen": { "type": "bool", "default": false },
    "graphics_quality": { "type": "enum", "enum": "GraphicsQuality", "default": "high" },
    "graphics_quality_chosen": { "type": "bool", "default": false },
    "shadows": { "type": "bool", "default": true },
    "shadows_chosen": { "type": "bool", "default": false }
  }
}
